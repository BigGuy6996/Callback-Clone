{
  "expo": {
    "name": "Callback Clone",
    "slug": "callback-clone",
    "version": "1.0.0",
    // NOTE (must change before store submission):
    // `android.package` and `ios.bundleIdentifier` below use the working
    // placeholder "com.callbackclone.app". The owner MUST replace both with
    // their real, unique app id (e.g. com.<owner>.callback) before submitting
    // to the Play Store / App Store — app ids cannot be changed once a build
    // is published. See README.md > "App id (must change before store submission)".
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "callbackclone",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.callbackclone.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.callbackclone.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
